# DevSprint AI Pipeline - Environment Variables
# Copy this file to .env and fill in your actual values

# === Database ===
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority

# === Gemini AI (Content Generation) ===
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# === Groq AI (Voiceover/Script Generation) ===
GROQ_API_KEY=your_groq_api_key_here


# === Hugging Face (TTS Audio) ===
HF_TOKEN=your_huggingface_token_here

# === Cloudinary (Image Hosting) ===
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# === Instagram Graph API ===
INSTA_ACCOUNT_ID=your_instagram_business_account_id
INSTA_ACCESS_TOKEN=your_instagram_access_token

# === YouTube OAuth ===
YOUTUBE_CLIENT_ID=your_youtube_client_id.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=http://localhost:3000/oauth2callback
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token


# === Optional Settings ===
PORT=3000
USE_CARBON_API=false
